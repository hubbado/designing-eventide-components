#!/usr/bin/env bash
# Runs the eval suite against a copy of the skill that holds nothing else, so
# that a run cannot read the work logs, and the evals never ship with the skill.
# Options pass through to `claude plugin eval` after the script's own, so that
# they win, such as --runs or --model.
set -euo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

target="$work/eval-target"
mkdir -p "$target/.claude-plugin" "$target/skills" "$target/evals"
cp -R "$repo/skills/designing-eventide-components" "$target/skills/"
rsync -a --exclude results "$repo/evals/" "$target/evals/"
printf '{ "name": "designing-eventide-components" }\n' > "$target/.claude-plugin/plugin.json"

# The file graders check files that a run writes, so the run needs Write, Edit
# and Bash. The judge is Opus: Haiku, the harness's default, failed replies that
# met their criteria, and Sonnet failed them too on replies of 1,500 words or
# more. No criterion compares a run with the skill to a run without it, so the
# run without it only doubles the cost. A case of a later stage starts from a
# design that its own scaffold script copies into the workspace.
claude plugin eval "$target" --trust-plugin --scaffold \
  --allow-tools Write Edit Bash --judge-model opus --ablation none \
  --output-dir "$repo/evals/results/$(date -u +%Y-%m-%d-%H%M%S)-$$" "$@"
